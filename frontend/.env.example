# Public frontend configuration. Firebase WEB config values are not server credentials.
# Leave these blank to use the synthetic demo without Firebase.
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# The Gmail integration is strictly for a separate, genuine listed-tester deployment.
VITE_ENABLE_GMAIL_TEST=false
VITE_GMAIL_TEST_CLIENT_ID=
